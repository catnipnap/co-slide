{
  "name": "co-slide",
  "displayName": "Co-Slide",
  "description": "실시간 AI 에이전트 협업 및 PPTX 네이티브 출력을 지원하는 차세대 프레젠테이션 에디터",
  "version": "0.1.0",
  "publisher": "kkihyeon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kkihyeon/co-slide"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:slideStudio.editor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "slideStudio.editor",
        "displayName": "Co-Slide",
        "selector": [
          {
            "filenamePattern": "*.slide.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "slideStudio.createNewDeck",
        "title": "Co-Slide: 새 프레젠테이션 생성"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.17.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.6"
  }
}
