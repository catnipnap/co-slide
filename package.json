{
  "name": "co-slide-ppt",
  "displayName": "Co-Slide PPT",
  "description": "Next-generation presentation slide editor with AI agent pairing & native PPTX export",
  "version": "0.2.6",
  "publisher": "catnipnap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/catnipnap/co-slide"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:slideStudio.editor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "slideStudio.editor",
        "displayName": "Co-Slide PPT",
        "selector": [
          {
            "filenamePattern": "*.slide.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "slideStudio.createNewDeck",
        "title": "Co-Slide PPT: 새 프레젠테이션 생성"
      }
    ],
    "keybindings": [
      {
        "command": "-workbench.action.gotoLine",
        "key": "ctrl+g",
        "when": "activeCustomEditorId == 'slideStudio.editor'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.17.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.6"
  }
}
